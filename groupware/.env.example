# 업무 챗봇(우측 하단)용 LLM 설정
# 이 파일을 .env 로 복사한 뒤 본인 API 값을 채우세요. (.env 는 git 에 올라가지 않음)
#
# LLM_PROVIDER 를 비워두면 규칙 기반 파서만 사용합니다. (API 없이도 시연 가능)
# LLM 호출이 실패하거나 시간 초과되면 자동으로 규칙 기반으로 대체됩니다.

# anthropic | azure | openai  (비우면 규칙 기반)
LLM_PROVIDER=

# LLM 응답 대기 한도(ms). 넘으면 규칙 기반으로 대체
LLM_TIMEOUT_MS=8000

# --- anthropic (Claude) ---
# 이 경우에만 한 번 설치 필요: npm install @anthropic-ai/sdk
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5

# --- azure (Azure OpenAI) ---
# AZURE_OPENAI_ENDPOINT=https://<리소스명>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=<배포 이름>
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- openai (또는 OpenAI 호환 사내 엔드포인트) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
